# Zypact environment configuration
#
# Copy this file to `.env.local` for local development.
# Never commit real credentials or private values.

# ── LLM provider ──────────────────────────────────────────────────────────────

# openai | anthropic | mock
# Leave blank to let the application infer the provider from available keys.
LLM_PROVIDER=

# Required only when using OpenAI.
OPENAI_API_KEY=

# Optional. Application default is used when blank.
OPENAI_MODEL=

# Required only when using Anthropic.
ANTHROPIC_API_KEY=

# Optional. Application default is used when blank.
ANTHROPIC_MODEL=

# Optional override used for generated assets.
ASSET_GENERATION_MODEL=

# ── Perplexity live probes ────────────────────────────────────────────────────

# Required for live Perplexity probes.
PERPLEXITY_API_KEY=

# Optional. Application default is used when blank.
PERPLEXITY_MODEL=

# ── Supabase ──────────────────────────────────────────────────────────────────
#
# REQUIRED IN PRODUCTION.
# When the URL or service-role key is missing or blank, the application fails
# closed in Production and refuses to start a database call. Preview and
# unrecognized environments also fail closed unless ZYPACT_ALLOW_MEMORY_DB is
# set. Local development and tests fall back to a non-persistent in-memory
# adapter.

NEXT_PUBLIC_SUPABASE_URL=

# Server-only secret. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Public browser key used for authentication and middleware.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Snapshot report writes are RPC-only. Every artifact mutation goes through a
# SECURITY DEFINER RPC — save_snapshot_report_artifact_manual,
# insert_snapshot_report_artifact_backfill, or mark_snapshot_report_delivered.
#
# No write-mode environment variable is required. SNAPSHOT_REPORT_WRITE_MODE is
# deliberately not listed below as a setting to define: absent configuration
# resolves to `rpc`, which is the only supported mode. `direct` and every other
# value are rejected as configuration errors and fail loudly. Set it only if you
# have a specific reason to state the mode explicitly, in which case the sole
# accepted value is exactly `rpc`.

# ── Public site ────────────────────────────────────────────────────────────────

# Optional canonical site URL. Application default is used when blank.
NEXT_PUBLIC_SITE_URL=

# ── Public snapshot request form ──────────────────────────────────────────────

# Set to "true" to accept snapshot requests. Default is closed.
SNAPSHOT_REQUESTS_ENABLED=

# Set to "true" to display the public snapshot form. Default is hidden.
SNAPSHOT_PUBLIC_FORM_ENABLED=

# Public Cloudflare Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Cloudflare Turnstile secret.
TURNSTILE_SECRET_KEY=

# Recommended in production.
# When blank, Turnstile hostname verification is skipped.
TURNSTILE_EXPECTED_HOSTNAME=

# Required when snapshot requests are enabled. Minimum 32 characters.
SNAPSHOT_IP_HASH_SECRET=

# Required for verification links.
# Use an HTTPS public URL in production; localhost is allowed in development.
SNAPSHOT_PUBLIC_BASE_URL=

# ── Email verification and delivery ──────────────────────────────────────────

# Set to "true" to require email verification. Default is closed.
SNAPSHOT_EMAIL_VERIFICATION_ENABLED=

# Resend server-only API key.
RESEND_API_KEY=

# Required sender address. Must contain "@".
SNAPSHOT_EMAIL_FROM=

# Optional reply-to address.
SNAPSHOT_EMAIL_REPLY_TO=

# Optional integer from 5 through 1440. Default is 30.
SNAPSHOT_EMAIL_VERIFICATION_TTL_MINUTES=

# ── Founder approval and notifications ───────────────────────────────────────

# Comma-separated founder email allowlist.
# An empty value disables founder admin access.
SNAPSHOT_FOUNDER_EMAILS=

# Set to "true" to enable founder approval actions.
SNAPSHOT_APPROVAL_ENABLED=

# Set to "true" to notify founders after email verification.
SNAPSHOT_FOUNDER_NOTIFICATIONS_ENABLED=

# ── Pricing and evidence links ────────────────────────────────────────────────

# Optional Stripe checkout URL for Growth.
STRIPE_GROWTH_URL=

# Optional Stripe checkout URL for Pro.
STRIPE_PRO_URL=

# Optional evidence-intake form URL. Application default is used when blank.
EVIDENCE_FORM_URL=

# ── Development and testing only ─────────────────────────────────────────────

# Explicitly permit the non-persistent in-memory database outside production.
# Never enable this in Production. Preview should normally use Supabase.
ZYPACT_ALLOW_MEMORY_DB=

# on | off | auto
ZYPACT_MOCK_MODE=

# Optional estimated cost per live probe. Application default is used when blank.
ZYPACT_ESTIMATED_COST_PER_LIVE_PROBE_USD=

# Optional test user UUID used by local MVP scripts.
MVP_TEST_USER_ID=
