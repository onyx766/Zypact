# M0 — protocol worker image.
#
# Inert by construction. The image carries no credential, no `.env` file and
# no Supabase, Perplexity, OpenAI or Anthropic value. `WORKER_EXECUTION_MODE`
# defaults to `disabled` here as well as in the code, so an image started with
# no environment at all is a worker that stays up, answers nothing but its own
# health surface, and spends nothing.
#
# The container is a WORKER, not a service: it publishes no port of its own
# and exposes nothing. The health surface exists for a supervisor, and the
# address it binds is decided by WORKER_HEALTH_HOST at run time — the default
# stays on the loopback.

# ----------------------------------------------------------------- deps
# A separate stage, so the production install is resolved once and the final
# image inherits node_modules without the npm cache or the build metadata.
#
# Both stages pin the SAME digest, and it is the multi-architecture OCI index
# rather than one platform's manifest: `--platform` still selects, but the
# tag can no longer move underneath the build. A tag is mutable — the same
# `node:24.19.0-bookworm-slim` can be repushed — and a build that silently
# changes base is a build whose earlier proofs no longer describe it. The
# digest also freezes the base image's own `docker-entrypoint.sh`, which the
# `ENTRYPOINT []` reset below already neutralises.
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# --omit=dev, deliberately: `tsx` is a runtime dependency precisely so that
# this install keeps it. typescript, tailwind, postcss and @types/* stay out.
RUN npm ci --omit=dev

# -------------------------------------------------------------- runtime
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS runtime
WORKDIR /app

# Defaults that make the image inert on its own. A host that forgets every
# variable gets the disabled worker with no health server at all; the Fly
# template is what turns the health port on.
ENV NODE_ENV=production \
    WORKER_EXECUTION_MODE=disabled \
    WORKER_HEALTH_PORT=0

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
# Exactly what the entrypoint needs: the manifests, the tsconfig that carries
# the `@/*` path mapping, the self-contained lib tree, and the entrypoint.
COPY --chown=node:node package.json package-lock.json tsconfig.json ./
COPY --chown=node:node lib ./lib
COPY --chown=node:node scripts/run-protocol-worker.ts ./scripts/run-protocol-worker.ts

# PR-2 — provenance. The commit this image claims to be built from is the
# only build argument, with no default: `fly deploy --build-arg GIT_SHA=$(git
# rev-parse HEAD)`. The RUN below refuses a missing or malformed value, which
# fails the build, so no image without provenance can be produced. It also
# writes build-provenance.json with the digest of the source files copied
# above (lib/protocol-worker/source-digest.ts), which
# `npm run verify:worker-provenance` recomputes from git to prove the image
# holds exactly that commit's files. Run as root before USER node, so the
# record is not writable by the worker. Not a credential.
ARG GIT_SHA
RUN node --import tsx -e "import('@/lib/protocol-worker/source-digest').then((m) => m.writeImageProvenance('.', process.env.GIT_SHA)).catch((e) => { console.error(e.message); process.exit(1); })"
ENV ZYPACT_BUILD_GIT_SHA=${GIT_SHA}
LABEL org.opencontainers.image.revision=${GIT_SHA}

# Non-root. The base image ships `node` (uid 1000); nothing here needs more.
USER node

# Fly sends the configured signal to the process started by CMD. SIGTERM is
# what the entrypoint installs a cooperative handler for.
STOPSIGNAL SIGTERM

# The base image declares ENTRYPOINT ["docker-entrypoint.sh"], and an image
# inherits it. That script happens to end in `exec "$@"`, so today node still
# becomes PID 1 — but only because of a branch inside a file this repository
# does not control. Resetting it removes the dependency rather than relying
# on it: only the last ENTRYPOINT in the chain is effective, and an empty one
# clears the inherited value.
ENTRYPOINT []

# PID 1 is the Node process itself, in exec form. No npm, no shell wrapper,
# no ENTRYPOINT: the `tsx` CLI forks a child that never receives the signal,
# and a shell would swallow it. One process is what a supervisor can signal.
CMD ["node", "--import", "tsx", "scripts/run-protocol-worker.ts"]
