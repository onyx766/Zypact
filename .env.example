# Zypact environment configuration
#
# Copy this file to `.env.local` for local development.
# Never commit real credentials or private values.

# ── LLM provider ──────────────────────────────────────────────────────────────

# openai | anthropic | mock
# Leave blank to let the application infer the provider from available keys.
LLM_PROVIDER=

# Required only when using OpenAI.
OPENAI_API_KEY=

# Optional. Application default is used when blank.
OPENAI_MODEL=

# Required only when using Anthropic.
ANTHROPIC_API_KEY=

# Optional. Application default is used when blank.
ANTHROPIC_MODEL=

# Optional override used for generated assets.
ASSET_GENERATION_MODEL=

# ── Perplexity live probes ────────────────────────────────────────────────────

# Required for live Perplexity probes.
PERPLEXITY_API_KEY=

# Optional. Application default is used when blank.
PERPLEXITY_MODEL=

# ── Supabase ──────────────────────────────────────────────────────────────────
#
# REQUIRED IN PRODUCTION.
# When the URL or service-role key is missing or blank, the application fails
# closed in Production and refuses to start a database call. Preview and
# unrecognized environments also fail closed unless ZYPACT_ALLOW_MEMORY_DB is
# set. Local development and tests fall back to a non-persistent in-memory
# adapter.

NEXT_PUBLIC_SUPABASE_URL=

# Server-only secret. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Public browser key used for authentication and middleware.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Snapshot report writes are RPC-only. Every artifact mutation goes through a
# SECURITY DEFINER RPC — save_snapshot_report_artifact_manual,
# insert_snapshot_report_artifact_backfill, or mark_snapshot_report_delivered.
#
# No write-mode environment variable is required. SNAPSHOT_REPORT_WRITE_MODE is
# deliberately not listed below as a setting to define: absent configuration
# resolves to `rpc`, which is the only supported mode. `direct` and every other
# value are rejected as configuration errors and fail loudly. Set it only if you
# have a specific reason to state the mode explicitly, in which case the sole
# accepted value is exactly `rpc`.

# ── Public site ────────────────────────────────────────────────────────────────

# Optional canonical site URL. Application default is used when blank.
NEXT_PUBLIC_SITE_URL=

# ── Public snapshot request form ──────────────────────────────────────────────

# Set to "true" to accept snapshot requests. Default is closed.
SNAPSHOT_REQUESTS_ENABLED=

# Set to "true" to display the public snapshot form. Default is hidden.
SNAPSHOT_PUBLIC_FORM_ENABLED=

# Required when snapshot requests are enabled. Minimum 32 characters.
SNAPSHOT_IP_HASH_SECRET=

# Required for verification links.
# Use an HTTPS public URL in production; localhost is allowed in development.
SNAPSHOT_PUBLIC_BASE_URL=

# ── Email verification and delivery ──────────────────────────────────────────

# Set to "true" to require email verification. Default is closed.
SNAPSHOT_EMAIL_VERIFICATION_ENABLED=

# Resend server-only API key.
RESEND_API_KEY=

# Required sender address. Must contain "@".
SNAPSHOT_EMAIL_FROM=

# Optional reply-to address.
SNAPSHOT_EMAIL_REPLY_TO=

# Optional integer from 5 through 1440. Default is 30.
SNAPSHOT_EMAIL_VERIFICATION_TTL_MINUTES=

# ── Founder approval and notifications ───────────────────────────────────────

# Comma-separated founder email allowlist.
# An empty value disables founder admin access.
SNAPSHOT_FOUNDER_EMAILS=

# Set to "true" to enable founder approval actions.
SNAPSHOT_APPROVAL_ENABLED=

# Set to "true" to notify founders after email verification.
SNAPSHOT_FOUNDER_NOTIFICATIONS_ENABLED=

# ── Pricing and evidence links ────────────────────────────────────────────────

# Optional Stripe checkout URL for Growth.
STRIPE_GROWTH_URL=

# Optional Stripe checkout URL for Pro.
STRIPE_PRO_URL=

# Optional evidence-intake form URL. Application default is used when blank.
EVIDENCE_FORM_URL=

# ── Development and testing only ─────────────────────────────────────────────

# Explicitly permit the non-persistent in-memory database outside production.
# Never enable this in Production. Preview should normally use Supabase.
ZYPACT_ALLOW_MEMORY_DB=

# on | off | auto
ZYPACT_MOCK_MODE=

# Optional estimated cost per live probe. Application default is used when blank.
ZYPACT_ESTIMATED_COST_PER_LIVE_PROBE_USD=

# Optional test user UUID used by local MVP scripts.
MVP_TEST_USER_ID=

# ── Protocol worker ───────────────────────────────────────────────────────────
#
# The worker is a long-running process (`npm run worker:protocol`), not a
# route. Once live it claims jobs and pays Perplexity and an analysis
# provider for real. It is therefore INERT BY DEFAULT.
#
# WORKER_EXECUTION_MODE — disabled | live. Absent or empty means disabled.
# Any other value is a configuration error and the process refuses to start.
#
#   disabled  the process stays up, answers the local health surface, and
#             does nothing else. It never opens a database client, never
#             claims a job, never builds a provider transport and never
#             calls fetch. NO Supabase, Perplexity, OpenAI or Anthropic
#             credential is required — or read — in this mode.
#             On SIGINT or SIGTERM it releases its keep-alive handle,
#             closes the health server and logs one final closed event,
#             `worker_execution_disabled_stopped`. That line is the proof
#             the stop was cooperative; a process killed outright cannot
#             print it.
#
#   live      REAL MONEY. Every variable in the live block below must be
#             present and valid before the worker touches the database.
#
# ZYPACT_MOCK_MODE IS NOT A WORKER MOCK SWITCH. It only routes the analysis
# leg to a fake; the Perplexity probe ignores it and always calls the
# provider. There is no "dry" worker — use WORKER_EXECUTION_MODE=disabled.
WORKER_EXECUTION_MODE=disabled

# ── Live mode: all of these are mandatory ─────────────────────────────────────
# Never commit a real project ref, key or token to this file.
#
# NODE_ENV must be exactly `production`.
# ZYPACT_ALLOW_MEMORY_DB must be absent or anything other than `true`.
# ZYPACT_MOCK_MODE must be exactly `off`.
# WORKER_ID          explicit, 3-64 chars of letters, digits, . _ or -
# WORKER_EXPECTED_SUPABASE_PROJECT_REF   twenty lowercase letters
# NEXT_PUBLIC_SUPABASE_URL   exactly https://<that ref>.supabase.co
#                            Canonical only: no credentials in the
#                            authority, no port, no path, no query, no
#                            fragment. Anything else is refused even when
#                            the hostname is right.
# SUPABASE_SERVICE_ROLE_KEY  required
# WORKER_LIVE_CONFIRM        exactly LIVE:<that ref> — a second, deliberate
#                            statement of which project is about to be used
# PERPLEXITY_API_KEY         required
# LLM_PROVIDER               exactly `openai`. `anthropic` is refused in
#                            live (TK-R-5): the only Anthropic model this
#                            repository names is `claude-3-5-sonnet-latest`,
#                            a floating alias, and no dated Anthropic
#                            snapshot has been decided. Inventing one would
#                            be worse than refusing. Mock and disabled modes
#                            are unaffected.
# WORKER_EXIT_AFTER_CLAIMED_JOB   required in live, exactly `true` or
#                            `false`. When true the loop exits after the
#                            FIRST iteration that actually claimed a job,
#                            whatever its outcome, and never claims again.
#                            Phase 3D runs with `true`.
# WORKER_PROVIDER_TIMEOUT_MS required in live, integer, >= 1000, and
#                            WORKER_PROVIDER_TIMEOUT_MS + WORKER_GRACE_MS must
#                            stay strictly below the lease. Applied separately
#                            to the Perplexity leg and the analysis leg,
#                            started immediately before the wire and covering
#                            the whole response, body read included.
# WORKER_MAX_RUNTIME_SECONDS required in live, in SECONDS, a plain decimal
#                            integer of at least 1. No default: a live run
#                            must state its own ceiling. Zero, a negative,
#                            a fraction (`120.5`), exponential notation
#                            (`1e3`), an explicit `+`, a unit suffix and
#                            anything past 2147483 are all refused — the
#                            last because that is the largest delay the
#                            timer enforcing this bound can represent, and
#                            a ceiling that silently overflows into "stop
#                            now" would be worse than no ceiling at all.
#                            2 x WORKER_PROVIDER_TIMEOUT_MS +
#                            WORKER_GRACE_MS must stay strictly below it in
#                            milliseconds. TWO, because one baseline slot
#                            makes two provider calls — Perplexity, then
#                            the analysis model — and the timeout bounds
#                            each of them separately. A ceiling that only
#                            reserved one leg plus the grace would let a
#                            claim start with the analysis window already
#                            unfunded: the probe paid for, the analysis cut
#                            off mid-call.
#                            This is a RESERVATION of the two provider
#                            windows and the grace, and nothing else. The
#                            job-scoped RPCs, the parsing and the
#                            persistence are NOT counted in it, so it is
#                            not a guarantee that a claim will run to
#                            completion. Admission compares
#                            `remaining >= required`, so a claim taken at
#                            exactly the reservation carries no modelled
#                            margin beyond those two windows and the grace.
#                            With the canary values that budget is
#                            2 x 45000 + 10000 = 100000 ms, so 100 is
#                            refused and 101 is the smallest accepted
#                            ceiling. 120 is the recommended value.
#                            It bounds the PROCESS, which nothing else
#                            does: the loop declines a new claim once the
#                            remaining runtime falls below that
#                            reservation, entering the last
#                            WORKER_GRACE_MS triggers the ordinary
#                            cooperative stop, and
#                            the absolute deadline ends the process even if
#                            the wind-down is itself stuck. The Phase 3D
#                            canary runs with 120.
#                            THE CANARY ALSO REQUIRES
#                            WORKER_MAX_SLOTS_PER_CLAIM=1, and the budget
#                            above is scoped to exactly that. The check
#                            happens before each CLAIM, not before each
#                            baseline slot, so a claim allowed to drive N
#                            slots would need 2 x N x the timeout. That
#                            generalisation is deliberately not implemented
#                            yet; one slot per claim makes the two bounds
#                            coincide.
#                            NOT read in disabled mode: absent or invalid
#                            there, it is ignored entirely.
# OPENAI_API_KEY             required
# OPENAI_MODEL               required in live, and must be a DATED snapshot
#                            ending in -YYYY-MM-DD, e.g.
#                            gpt-4o-mini-2024-07-18. Floating aliases
#                            (`gpt-4o-mini`, `gpt-4o`, …) and anything
#                            ending in `latest` are refused before any
#                            request is prepared: an evidence receipt that
#                            names a moving target proves nothing about
#                            what actually answered.
#
# WORKER_ID=
# WORKER_EXPECTED_SUPABASE_PROJECT_REF=
# WORKER_LIVE_CONFIRM=

# ── Tunables, with their defaults ─────────────────────────────────────────────
# A value that is supplied but invalid is a startup error, never a silent
# return to the default. A variable defined but empty counts as supplied.
# Integers must be safe integers; every variable has an explicit ceiling.
#
# WORKER_LEASE_SECONDS=60          lease held on a claimed job
# WORKER_GRACE_MS=10000            shutdown budget; must be strictly less
#                                  than WORKER_LEASE_SECONDS x 1000
# WORKER_IDLE_BACKOFF_MS=2000      wait after an empty claim
# WORKER_MAX_BACKOFF_MS=30000      ceiling on that backoff
# WORKER_MAX_SLOTS_PER_CLAIM=32    baseline slots advanced per claim
# WORKER_JITTER_RATIO=0.5          backoff jitter, between 0 and 1
# WORKER_MAX_THROTTLED_RETRIES=3   retries under one claim on a throttle
# WORKER_PERPLEXITY_RESERVED_USD=0.02   greater than 0, at most 10.00
# WORKER_ANALYSIS_RESERVED_USD=0.02     greater than 0, at most 10.00
#                                  The ceiling is deliberate: admission
#                                  control reserves the figure for real,
#                                  so a typo must not become a budget.
# WORKER_HEALTH_PORT=0             0 disables the server entirely; 0..65535
# WORKER_HEALTH_HOST=127.0.0.1     bind address; ONLY 127.0.0.1 or 0.0.0.0.
#                                  Absent means 127.0.0.1. A hostname, an
#                                  IPv6 form, an empty value or a stray
#                                  space is a startup error, not a guess:
#                                  the value is compared exactly, never
#                                  trimmed, lower-cased or resolved by DNS.
#                                  Set 0.0.0.0 only to let an orchestrator
#                                  off this host reach /healthz and /readyz.
#                                  Widening the bind never widens the
#                                  payload: both endpoints stay closed
#                                  scalars. WORKER_HEALTH_PORT=0 still
#                                  means no server at all, whatever this
#                                  is set to.
# WORKER_READY_STALE_MS=60000      /readyz staleness bound in live mode
#
# Ceilings: lease 86400 s; every millisecond duration 86400000; counts and
# retries 10000; jitter 1; reserved cost 10.00 USD; port 65535; total
# runtime 2147483 s.
